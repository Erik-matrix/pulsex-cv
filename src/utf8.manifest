<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process's ANSI code page is UTF-8 (Windows 10 1903+): every narrow path in the program (fopen, ifstream,
     std::filesystem::path(std::string), CreateProcessA, the known-folder paths) is UTF-8, so a user name or a
     folder with letters outside ASCII works. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
